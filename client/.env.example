# Tab's own number, used for the contact card it sends at onboarding (E.164).
TAB_PHONE=
# Display name on that contact card.
TAB_NAME=Tab
# Optional: group chat guids to switch on at startup, comma-separated (find them with `bun run chats`).
# Usually you just text "/tab on" into the group from Tab's phone instead.
TAB_GROUP_IDS=
# How long after Tab DMs someone their plain replies count as replies to Tab.
DM_REPLY_WINDOW_HOURS=72
# spectrum (default) sends through Photon Spectrum's local provider; osascript drives Messages.app directly.
SEND_VIA=spectrum
# ui (default) sends tapbacks by driving Messages.app's interface (needs Accessibility permission); off disables them.
TAPBACK_MODE=ui
# dev is the stand-in hub with @tab ping/dm/card echo commands. spacetime arrives with the module bindings.
HUB=dev
ECHO=1
# Port for receipt images, /health, and the dev outbox endpoint.
CLIENT_PORT=8787
# Base URL the backend uses to fetch receipt images. Use your LAN IP or a tunnel if the backend runs elsewhere.
IMAGE_BASE_URL=http://localhost:8787
NESSIE_API_KEY=