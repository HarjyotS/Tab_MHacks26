# Tab's own number, used for the contact card it sends at onboarding (E.164).
TAB_PHONE=
# Tab's Apple Account email. For an iPhone-only Tab with no number, this is
# what it texts from and what the contact card carries.
TAB_EMAIL=
# on: Tab switches itself on in every group it's added to ("/tab off" still
# turns a group off for good). Only on Tab's own account: on a personal one
# it would join every group you're in.
AUTO_JOIN=off
# Display name on that contact card.
TAB_NAME=Tab
# Optional: group chat guids to switch on at startup, comma-separated (find them with `bun run chats`).
# Usually you just text "/tab on" into the group from Tab's phone instead.
TAB_GROUP_IDS=
# How long after Tab DMs someone their plain replies count as replies to Tab.
DM_REPLY_WINDOW_HOURS=72
# off = never read any DM; Tab only sees enabled groups (it can still send DM confirmations).
READ_DMS=on
# spectrum (default) sends through Photon Spectrum's local provider; osascript drives Messages.app directly.
SEND_VIA=spectrum
# ui (default) sends tapbacks by driving Messages.app's interface (needs Accessibility permission, newest
# message only); imsg sends them through imsg's helper inside Messages (any message, SIP off, see
# ops/README.md "Private API"); off disables them.
TAPBACK_MODE=ui
# ui (default) sends inline replies when the backend names a target message (newest message only); imsg threads
# onto any message; off sends them as normal messages.
REPLY_MODE=ui
# Where imsg is installed (brew install steipete/tap/imsg).
IMSG_PATH=/opt/homebrew/bin/imsg
# backend talks to the backend on this Mac, which keeps the data in Postgres (the server uses this).
# dev is the stand-in hub with @tab ping/dm/card/like echo commands; spacetime connects to the old module.
HUB=dev
ECHO=1
# HUB=backend: where the backend's hub listens (its HUB_PORT), and TAB_HUB_TOKEN if it asks for one.
BACKEND_HUB_URL=http://127.0.0.1:4100
TAB_HUB_TOKEN=
SPACETIME_HOST=http://127.0.0.1:3000
SPACETIME_DB=tab-local
# Shared database: SPACETIME_HOST=https://maincloud.spacetimedb.com and SPACETIME_DB=tabmhacks2026-268xk.
# Optional. Without it, the client creates its own identity and saves the token in .state/spacetime-token-<database>.
SPACETIME_CLIENT_TOKEN=
GROUP_TIMEZONE=America/Detroit
# Port for receipt images, /health, and the dev outbox endpoint.
CLIENT_PORT=8787
# Base URL the backend uses to fetch receipt images. Use your LAN IP or a tunnel if the backend runs elsewhere.
IMAGE_BASE_URL=http://localhost:8787
NESSIE_API_KEY=
# Where the bridge's photo server listens. 127.0.0.1 (the default) keeps
# receipt photos on this Mac; the backend fetches them locally.
CLIENT_HOST=127.0.0.1
