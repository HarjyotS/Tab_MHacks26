# Tab marketing site (addtab.app). Copy to .env.local for local work; set the same names in Vercel.
# With nothing set, `npm run dev` still works: sign-ups go to an in-memory list and Turnstile uses
# Cloudflare's always-pass test keys (both log a warning). Never rely on that outside your machine.

# --- Waitlist storage: AWS DynamoDB (required in production; the Vercel production build fails without them) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Existing table, partition key `phone` (String, E.164). Defaults to tab-waitlist.
WAITLIST_TABLE=tab-waitlist

# Secret used to hash visitor IPs (HMAC-SHA256). The raw IP is never stored. Required in production.
# Generate one with: openssl rand -hex 32
IP_HASH_SECRET=

# --- Bot protection: Cloudflare Turnstile (optional for now; without it sign-ups skip the bot check and log a warning) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics: PostHog (optional; nothing loads when the key is empty) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Signup hook to Tab (optional; until set, notifyWaitlistSignup only logs) ---
TAB_SIGNUP_WEBHOOK_URL=
TAB_SIGNUP_WEBHOOK_SECRET=

# --- Internal admin page at /admin (HTTP Basic auth) ---
# Both must be set or /admin (and /admin/export.csv) is a 404 everywhere except `next dev`,
# where it opens without a password and logs a warning. Use a long random password:
#   openssl rand -base64 24
ADMIN_USER=
ADMIN_PASSWORD=

# --- Misc ---
# Canonical URL for metadata, Open Graph, robots and sitemap. Defaults to https://addtab.app
NEXT_PUBLIC_SITE_URL=https://addtab.app
# Local only: allow the dev fallbacks under `next build && next start`. Ignored on Vercel production.
# WAITLIST_DEV_FALLBACK=1
