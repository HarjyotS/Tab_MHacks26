SPACETIME_HOST=http://127.0.0.1:3000
SPACETIME_DB=tab-local
SPACETIME_AUTH_TOKEN=
VITE_SPACETIME_HOST=wss://maincloud.spacetimedb.com
VITE_SPACETIME_DB=tabmhacks2026-268xk
NESSIE_API_KEY=
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
DEMO_STARTING_BALANCE=50000
DEMO_MODE=false

# Backend: Grok (xAI), https://console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-4.20-0309-non-reasoning
# Backend's own SpacetimeDB identity token (granted the backend role)
BACKEND_SPACETIME_TOKEN=
DEMO_TIME_SCALE=360
# Web ledger links ("@tab ledger", SPEC 12.3). Where the web app is hosted,
# and a private key (32+ chars, e.g. `openssl rand -base64 32`) that derives
# each group's link. Leave both empty and Tab posts no links.
LEDGER_BASE_URL=
LEDGER_LINK_KEY=
# Backend gate: TypeSafe's Jev classifier (the keyword stub when unset)
TYPESAFE_API_KEY=
# Free local check that skips Jev for messages that can't be about money.
# On by default; off|false|0|no sends every message to Jev.
GATE_PREFILTER=on
